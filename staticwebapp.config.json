{
    "routes": [
        {
            "route": "/admin",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/dashboard",
            "redirect": "/admin"
        },
        {
            "route": "/login",
            "rewrite": "/.auth/login/aad"
        },
        {
            "route": "/logout",
            "rewrite": "/.auth/logout"
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html"
    }
}